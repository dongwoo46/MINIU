{
  "name": "believe-in-me",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app shared entities widgets next.config.ts",
    "typecheck": "tsc --noEmit",
    "security:env": "node tools/check-env-files.js",
    "openapi:gen": "node tools/openapi.js",
    "agents:check": "node tools/sync-agents.js --check",
    "agents:sync": "node tools/sync-agents.js --write",
    "docs:check": "node tools/docs.js check",
    "docs:html": "node tools/docs.js html",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3"
  }
}
